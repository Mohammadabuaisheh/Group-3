<%- include('./partials/header') %>
<%- include('./partials/nav') %>

<div class="container my-5 text-center">
    <h2 class="fw-bold mb-4">Welcome to your Dashboard, <%= user.name %>! 🐾</h2>
    <p class="fs-5 text-secondary mb-5">Manage your reports, applications, and account settings.</p>

    <div class="row g-4 justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm p-4 border-0 rounded-4 h-100">
                <h4 class="fw-bold text-success mb-3">My Reports</h4>
                <p>View the status of the animals you have reported.</p>
                <a href="/my-reports" class="btn btn-success mt-auto">View Reports</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm p-4 border-0 rounded-4 h-100">
                <h4 class="fw-bold text-primary mb-3">My Adoptions</h4>
                <p>Track your submitted adoption requests.</p>
                <a href="/my-adoptions" class="btn btn-primary mt-auto">View Applications</a>
            </div>
        </div>
        <% if (user.role === 'admin') { %>
            <div class="col-md-4">
                <div class="card shadow-sm p-4 border-0 rounded-4 h-100 bg-warning-subtle border-warning">
                    <h4 class="fw-bold text-dark mb-3">👑 Admin Control</h4>
                    <p>System metrics, user directory, and summary analytics.</p>
                    <a href="/admin" class="btn btn-warning fw-bold mt-auto">Open Admin Panel</a>
                </div>
            </div>
        <% } %>
    </div>
</div>

<%- include('./partials/footer') %>