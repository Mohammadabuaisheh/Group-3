<%- include('partials/header') %>
 
<div class="container d-flex flex-column justify-content-center align-items-center min-vh-100 text-center">
<h1 class="display-1 fw-bold text-danger">404</h1>
<h2 class="mb-4">Page Not Found</h2>
<div class="alert alert-warning col-md-6 shadow-sm">
<% if (typeof message !== 'undefined' && message) { %>
<p class="mb-0 fs-5"><%= message %></p>
<% } else { %>
<p class="mb-0 fs-5">Sorry, the page you are looking for does not exist on SafePaws.</p>
<% } %>
</div>
 
    <a href="/" class="btn btn-primary btn-lg mt-3 px-5 rounded-pill shadow-sm">Back to Home</a>
</div>
 
<%- include('partials/footer') %>