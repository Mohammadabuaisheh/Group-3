<!DOCTYPE html>
<html>
<head>
    <title>Contact Us - SafePaws</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<%- include('partials/nav') %>

<div class="container my-5">
  <!-- Section Title -->
  <div class="row mb-4">
    <div class="col-md-10 mx-auto text-start">
      <h2 class="fw-bold text-dark">Contact SafePaws</h2>
      <hr>
      <p class="fs-5 text-secondary lh-base">
        Have questions about adoption, volunteering, or rescue efforts? Send us a message and our team will get back to you as soon as possible.
      </p>
    </div>
  </div>

  <!-- Form and Info Section -->
  <div class="row g-4 col-md-10 mx-auto">
    <!-- Contact Info Card -->
    <div class="col-md-4">
      <div class="card border shadow-sm rounded p-4 h-100 bg-light">
        <h4 class="fw-bold text-dark mb-3">Get in Touch</h4>
        <p class="text-secondary mb-3">📍 <strong>Address:</strong> 123 SafePaws St, Shelter City</p>
        <p class="text-secondary mb-3">📞 <strong>Phone:</strong> +1 (234) 567-890</p>
        <p class="text-secondary mb-3">✉️ <strong>Email:</strong> support@safepaws.org</p>
        <p class="text-secondary mb-0">⏰ <strong>Hours:</strong> Mon - Fri, 9 AM - 6 PM</p>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="col-md-8">
      <div class="card border shadow-sm rounded p-4">
        <form action="/submit" method="POST">
          <div class="mb-3">
            <label class="form-label fw-semibold text-dark">Your Name</label>
            <input type="text" name="title" class="form-control" placeholder="Enter your full name" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold text-dark">Email Address</label>
            <input type="email" class="form-control" placeholder="name@example.com" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold text-dark">Message</label>
            <textarea name="description" class="form-control" rows="4" placeholder="How can we help you?" required></textarea>
          </div>

          <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">Send Message</button>
        </form>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-md-10 mx-auto">
      <a href="/" class="btn btn-link text-decoration-none p-0 text-secondary">← Back Home</a>
    </div>
  </div>
</div>

</body>
</html>