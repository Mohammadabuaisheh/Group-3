<%- include('./partials/header') %>
<%- include('./partials/nav') %>

<div class="container my-5">
  <div class="row mb-5">
    <div class="col-md-10 mx-auto text-start">
      <h2 class="fw-bold text-dark">About SafePaws</h2>
      <hr>
      <p class="fs-5 text-secondary lh-base">
        Our mission is to streamline animal care by creating a unified digital hub. Instead of searching across scattered channels, SafePaws brings adoption listings, rescue alerts, and medical funding together under one platform.
      </p>
      
      <h4 class="fw-bold text-dark mt-4">Why We Started</h4>
      <p class="fs-5 text-secondary lh-base">
        The core challenge that drove us to build SafePaws was the difficulty animal shelters face in coordinating rescue efforts and connecting with prospective adopters. By centralizing these services, we offer sustainable solutions to protect vulnerable animals and grant them a second chance at a loving home.
      </p>
    </div>
  </div>

  <div class="row my-4">
    <div class="col-md-10 mx-auto">
      <h4 class="fw-bold mb-3 text-dark">Project Team (Group 3)</h4>
      <ul class="list-group list-group-flush shadow-sm rounded border">
        <% if (typeof team !== 'undefined' && team.length > 0) { %>
          <% team.forEach(member => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
              <span class="fw-semibold">👤 <%= member.name %></span>
              <span class="badge bg-secondary rounded-pill fs-6">ID: <%= member.id %></span>
            </li>
          <% }) %>
        <% } else { %>
          <li class="list-group-item text-muted">Team details coming soon.</li>
        <% } %>
      </ul>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>