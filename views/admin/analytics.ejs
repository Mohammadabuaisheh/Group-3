<%- include('../partials/header') %>
<%- include('../partials/nav') %>

<div class="container my-5">
  <h2 class="mb-4">📊 System Summary Analytics</h2>

  <div class="row text-center mb-4">
    <div class="col-md-4">
      <div class="card bg-primary text-white p-3 shadow-sm">
        <h3><%= stats.totalUsers %></h3>
        <p class="mb-0">Total Users</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-warning text-dark p-3 shadow-sm">
        <h3><%= stats.totalReports %></h3>
        <p class="mb-0">Total Reports</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card bg-success text-white p-3 shadow-sm">
        <h3><%= stats.totalAnimals %></h3>
        <p class="mb-0">Total Animals</p>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-4">
      <div class="card p-3 shadow-sm">
        <h4>Animals Breakdown by Type</h4>
        <ul class="list-group list-group-flush mt-2">
          <% stats.animalsByType.forEach(item => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%= item._id || 'Unknown' %>
              <span class="badge bg-primary rounded-pill"><%= item.count %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>

    <div class="col-md-6 mb-4">
      <div class="card p-3 shadow-sm">
        <h4>Reports Breakdown by Status</h4>
        <ul class="list-group list-group-flush mt-2">
          <% stats.reportsByStatus.forEach(item => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%= item._id || 'Pending' %>
              <span class="badge bg-info rounded-pill"><%= item.count %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>