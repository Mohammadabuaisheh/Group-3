<%- include('partials/header') %>
 
<div class="container mt-5 mb-5">
<div class="text-center mb-5">
<h1 class="display-4 fw-bold">Our Core Services</h1>
<p class="lead text-muted">Building a comprehensive and effective community for animal care and protection.</p>
</div>
 
    <div class="row g-4">
<% for (let i = 0; i < services.length; i++) { %>
<div class="col-md-4">
<div class="card h-100 shadow-sm border-0">
<div class="card-body text-center p-4">
<h2 class="card-title h4 text-primary mb-3"><%= services[i].name %></h2>
<p class="card-text"><%= services[i].description %></p>
</div>
</div>
</div>
<% } %>
</div>
</div>
 
<%- include('partials/footer') %>