<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Reports</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">



</head>
<body>
    <%- include('partials/nav')%>
    <div class="container my-5">
        <div class="row mb-4">
            <h2 class="fw-bold text-dark">My reports</h2>
            <hr>

            <p class="fs-5 text-secondary">
                view the animal reports you have submitted
            </p>


        




    </div>
    <% if (success){ %>
        <div class="alert alert-success col-md-10 mx auto">
            report submitted successfuly!!
        </div>
   

     <% } %>
    <div class ="row g-4 col-md-10 mx-auto">
        <% if (reports.length === 0) { %>

            <div class="col-12">
                <div class="alert alert-secondary text-center">
                    You have not submitted any reports yet.
                </div>
            </div>
        <%} else {%>
            <% for (let report of reports){ %>
                <div class="col-md-6">
                    <div class="card border shadow-sm rounded p-4 h-100">

                        <h4 class="fw-bold text-dark mb-3">
                            <%= report.animalName || "Unknown Animal" %>
                        </h4>

                        <p>
                            <strong>Type:</strong>
                                <%= report.type %>

                           
                        </p>
                         <p>
                            <strong>Status:</strong>
                                <%= report.status %>

                            
                        </p>
 <p>
                            <strong>Behavior:</strong>
                                <%= report.behavior|| "not spacified" %>

                            
                        </p>
 <p>
                            <strong>Location:</strong>
                                <%= report.location %>

                            
                        </p>

                        <p class="mb-0">
                            <strong>Description</strong>
                            <%= report.description%>
                        </p>






                </div>

                </div>



            <% } %> 

       <% }  %>




    </div>

    <div class="row mt-4">
        <div class="col-md-10 mx-auto">
            <a href="/report-animal" class="btn btn-success">
                submit new report 
            </a>
            <a href="/" class="btn btn-success">
                Back Home
            </a>
        </div>
    </div>
    </div>

    
  
    

    
</body>
</html>